PUBLIC_HOST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
VICTIM_NUMBER=
EMERGENCY_CONTACT_NUMBER=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# Optional: Twilio API key for the browser phones (created automatically if empty)
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Speech-to-text language: lt, en-US or multi
TRANSCRIPTION_LANGUAGE=lt
# Family to text on level 3 / 5, "Name:+370...,Name:+370..." (falls back to EMERGENCY_CONTACT_NUMBER)
FAMILY_CONTACTS=
# The protected person in dative, used in SMS texts, e.g. Mamai
VICTIM_NAME=
# Set to false while testing: SMS actions are shown but not sent
SMS_ENABLED=true
# f or m, for "Paskambinkite jai / jam" in the texts
VICTIM_GENDER=
